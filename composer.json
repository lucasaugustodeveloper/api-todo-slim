{
    "name": "lucasaugustodeveloper/slim-api",
    "description": "API REST com Slim Framework 4",
    "type": "project",
    "require": {
        "php": "^8.3",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public"
    }
}
